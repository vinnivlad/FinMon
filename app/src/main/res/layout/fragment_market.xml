<?xml version="1.0" encoding="utf-8"?>
<!--
    Market screen — editorial direction.
    ▸ Held-stocks row: "HELD" kicker + chip group, horizontally scrollable.
    ▸ Search field: square outlined exposed-dropdown.
    ▸ Header section (no card): top rule + accent stripe, ticker + italic name +
      refresh, split-headline price + colored % delta, bottom meta line, hairline.
    ▸ Period chips: Widget.FinMon pill chips, scrollable.
    ▸ Chart: editorial line.
    ▸ Empty state: italic serif copy.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ===== Held-stocks row ===== -->
    <HorizontalScrollView
        android:id="@+id/heldStocksScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/fm_page_padding_h"
        android:paddingTop="10dp"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/market_held_label"
                android:textAppearance="@style/TextAppearance.FinMon.Kicker"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/heldStocksChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="6dp"
                app:singleLine="true"
                app:singleSelection="true"
                app:selectionRequired="false" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ===== Search field =====
         Editorial reinterpretation of the JSX "search row":
           ▸ leading magnifier icon (cues "search", replaces the floating-label dance)
           ▸ TICKER / CO. kicker on the right
           ▸ exposed-dropdown chevron on the far right (built-in via the style)
    -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/searchLayout"
        style="@style/Widget.FinMon.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/fm_page_padding_h"
        android:layout_marginTop="8dp"
        android:hint="@string/market_search_hint"
        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="@color/fm_ink_soft"
        app:suffixText="@string/market_search_suffix"
        app:suffixTextAppearance="@style/TextAppearance.FinMon.Kicker"
        app:layout_constraintTop_toBottomOf="@id/heldStocksScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/searchField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:imeOptions="actionSearch" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- ===== Header section (no card) ===== -->
    <LinearLayout
        android:id="@+id/headerCard"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/fm_page_padding_h"
        android:layout_marginTop="14dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/searchLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/fm_rule_strong"
            android:background="?attr/colorOutline" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:layout_width="28dp"
                android:layout_height="4dp"
                android:layout_gravity="top|start"
                android:background="?attr/colorPrimary" />

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="4dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <!-- Line 1: ticker · italic name · refresh -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/headerTicker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.FinMon.Title.Medium"
                        android:textFontWeight="700"
                        tools:text="VOO" />

                    <TextView
                        android:id="@+id/headerName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:textAppearance="@style/TextAppearance.FinMon.Body.Italic"
                        android:textSize="12sp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        tools:text="Vanguard S&amp;P 500 ETF" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/refreshButton"
                        style="@style/Widget.FinMon.IconButton"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/market_action_refresh"
                        app:icon="@drawable/ic_refresh" />
                </LinearLayout>

                <!-- Line 2: split price + arrow/percent right-aligned -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp"
                    android:baselineAligned="true">

                    <TextView
                        android:id="@+id/headerPriceInteger"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.FinMon.Display.Headline"
                        android:textFontWeight="500"
                        android:letterSpacing="-0.025"
                        tools:text="652" />

                    <TextView
                        android:id="@+id/headerPriceFraction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.FinMon.Display.Small"
                        android:textColor="@color/fm_ink_soft"
                        android:layout_marginStart="2dp"
                        tools:text=".51" />

                    <TextView
                        android:id="@+id/headerPriceCurrency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.FinMon.Kicker"
                        android:layout_marginStart="6dp"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="6dp"
                        tools:text="USD" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/headerPctDelta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="6dp"
                        android:textAppearance="@style/TextAppearance.FinMon.Mono.Medium"
                        tools:text="▲ +12.32%"
                        tools:textColor="@color/pnl_positive" />
                </LinearLayout>

                <!-- Line 3: meta · signed delta + period -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp"
                    android:baselineAligned="true">

                    <TextView
                        android:id="@+id/headerMeta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.FinMon.Kicker"
                        android:textAllCaps="false"
                        android:letterSpacing="0.04"
                        tools:text="Apr 28, 11:56:10 · USD" />

                    <TextView
                        android:id="@+id/headerSignedDelta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.FinMon.Mono.Small"
                        tools:text="+71.58 · 1m"
                        tools:textColor="@color/pnl_positive" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/fm_rule_hairline"
            android:background="?attr/colorOutlineVariant" />
    </LinearLayout>

    <!-- ===== Period chips ===== -->
    <HorizontalScrollView
        android:id="@+id/periodChipsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/fm_page_padding_h"
        android:paddingTop="10dp"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/headerCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/periodChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="6dp"
            app:singleLine="true"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/marketPeriod1d"
                style="@style/Widget.FinMon.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/market_period_1d" />

            <com.google.android.material.chip.Chip
                android:id="@+id/marketPeriod5d"
                style="@style/Widget.FinMon.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/market_period_5d" />

            <com.google.android.material.chip.Chip
                android:id="@+id/marketPeriod1m"
                style="@style/Widget.FinMon.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/market_period_1m" />

            <com.google.android.material.chip.Chip
                android:id="@+id/marketPeriod6m"
                style="@style/Widget.FinMon.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/market_period_6m" />

            <com.google.android.material.chip.Chip
                android:id="@+id/marketPeriodYtd"
                style="@style/Widget.FinMon.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/market_period_ytd" />

            <com.google.android.material.chip.Chip
                android:id="@+id/marketPeriod1y"
                style="@style/Widget.FinMon.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/market_period_1y" />

            <com.google.android.material.chip.Chip
                android:id="@+id/marketPeriod5y"
                style="@style/Widget.FinMon.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/market_period_5y" />

            <com.google.android.material.chip.Chip
                android:id="@+id/marketPeriodAll"
                style="@style/Widget.FinMon.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/market_period_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/marketPeriodCustom"
                style="@style/Widget.FinMon.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/market_period_custom" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- ===== Chart ===== -->
    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/periodChipsScroll"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/emptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/market_empty_state"
        android:textAppearance="@style/TextAppearance.FinMon.Body.Italic"
        android:textAlignment="center"
        android:padding="32dp"
        app:layout_constraintTop_toBottomOf="@id/searchLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
