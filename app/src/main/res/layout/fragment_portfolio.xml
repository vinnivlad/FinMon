<?xml version="1.0" encoding="utf-8"?>
<!--
    Portfolio screen — editorial direction.
    Layout structure (top → bottom):
      ▸ Totals section: 2 dp ink top rule, 28×4 accent stripe, headline split number,
        FX equivalents, internal hairline rule, Invested + Period P&L row,
        1 dp bottom rule.
      ▸ Cash bar: 3-segment row of cash piles + 1 dp rule below.
      ▸ Holdings section header bar: "HOLDINGS" kicker + sort indicator,
        ruled top + bottom.
      ▸ Holdings RecyclerView.
      ▸ Square ink-fill FAB anchored bottom-right.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ===== Totals section ===== -->
    <LinearLayout
        android:id="@+id/totalsCard"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/fm_page_padding_h"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/fm_rule_strong"
            android:background="?attr/colorOutline" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Accent stripe: 28×4, top-start, kisses the top rule -->
            <View
                android:layout_width="28dp"
                android:layout_height="4dp"
                android:layout_gravity="top|start"
                android:background="?attr/colorPrimary" />

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="4dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/totalsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/totals_card_label"
                    android:textAppearance="@style/TextAppearance.FinMon.Kicker" />

                <!-- Headline number: integer + fraction + currency code -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/totalAmountInteger"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.FinMon.Display.Headline"
                        android:textFontWeight="500"
                        android:letterSpacing="-0.025"
                        tools:text="136,414" />

                    <TextView
                        android:id="@+id/totalAmountFraction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.FinMon.Display.Small"
                        android:textColor="@color/fm_ink_soft"
                        android:layout_marginStart="2dp"
                        tools:text=".93" />

                    <TextView
                        android:id="@+id/totalAmountCurrency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.FinMon.Kicker"
                        android:layout_marginStart="8dp"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="6dp"
                        tools:text="USD" />
                </LinearLayout>

                <TextView
                    android:id="@+id/totalDisplayEquivalents"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.FinMon.Mono.Small"
                    android:layout_marginTop="6dp"
                    tools:text="≈ 116,584.00 EUR · 6,013,402 UAH" />

                <!-- Internal hairline rule -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/fm_rule_hairline"
                    android:layout_marginTop="10dp"
                    android:background="?attr/colorOutlineVariant" />

                <!-- Invested + Period P&L row -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="true">

                    <TextView
                        android:id="@+id/totalInvested"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.FinMon.Body.Small"
                        tools:text="Invested 114,085.56" />

                    <TextView
                        android:id="@+id/totalPnl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.FinMon.Mono.Medium"
                        tools:text="▲ +5,065.86 (+4.5%)"
                        tools:textColor="@color/pnl_positive" />
                </LinearLayout>

                <TextView
                    android:id="@+id/fxGapHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/totals_fx_gap_hint"
                    android:textAppearance="@style/TextAppearance.FinMon.Body.Italic"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/fm_rule_hairline"
            android:background="?attr/colorOutlineVariant" />
    </LinearLayout>

    <!-- ===== Cash bar ===== -->
    <LinearLayout
        android:id="@+id/cashBarContainer"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/fm_page_padding_h"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/totalsCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <TextView
            android:id="@+id/cashBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="4dp"
            android:textAppearance="@style/TextAppearance.FinMon.Mono.Medium"
            android:textColor="?attr/colorOnBackground"
            tools:text="$  996.59   ·   €  3,682.24   ·   ₴  560.77" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/fm_rule_hairline"
            android:background="?attr/colorOutlineVariant" />
    </LinearLayout>

    <!-- ===== Holdings header bar ===== -->
    <LinearLayout
        android:id="@+id/holdingsHeader"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/fm_page_padding_h"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/cashBarContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/fm_rule_hairline"
            android:background="?attr/colorOutlineVariant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="6dp"
            android:text="@string/portfolio_holdings_kicker"
            android:textAppearance="@style/TextAppearance.FinMon.Kicker"
            android:textColor="?attr/colorOnBackground"
            android:textFontWeight="700" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/fm_rule_hairline"
            android:background="?attr/colorOutlineVariant" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/holdingsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layout_constraintTop_toBottomOf="@id/holdingsHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/emptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/portfolio_placeholder"
        android:textAppearance="@style/TextAppearance.FinMon.Body.Italic"
        android:textAlignment="center"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/holdingsHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        style="@style/Widget.FinMon.FAB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="@string/fab_add"
        android:src="@drawable/ic_add"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
