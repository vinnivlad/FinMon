<?xml version="1.0" encoding="utf-8"?>
<!--
    Editorial masthead — two rows: kicker date + gear button on top, screen title +
    hairline rule fill + "FinMon" all-caps kicker below. Bottom border is a 2 dp ink
    stripe (ruleStrong) per the spec.

    Use via:
      <include android:id="@+id/masthead" layout="@layout/view_masthead" />
    Then bind from the fragment:
      TextView title = view.findViewById(R.id.mastheadTitle);
      title.setText(R.string.portfolio_title);
      TextView date = view.findViewById(R.id.mastheadDate);
      date.setText(formattedToday());
      view.findViewById(R.id.mastheadSettingsButton).setOnClickListener(...);
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/fm_page_padding_h"
    android:paddingEnd="@dimen/fm_page_padding_h"
    android:paddingTop="8dp"
    android:paddingBottom="10dp"
    android:background="?android:attr/colorBackground">

    <!-- Top row: kicker date · gear button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/mastheadDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.FinMon.Kicker"
            tools:text="Friday · 2 May 2026" />

        <ImageButton
            android:id="@+id/mastheadSettingsButton"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_settings"
            android:scaleType="centerInside"
            android:background="@android:color/transparent"
            android:padding="4dp"
            app:tint="@color/fm_ink_soft"
            android:contentDescription="@string/settings_title" />
    </LinearLayout>

    <!-- Title row: serif title · hairline rule · FinMon kicker -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/mastheadTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.FinMon.Display.Large"
            android:singleLine="true"
            tools:text="Portfolio" />

        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/fm_rule_hairline"
            android:layout_weight="1"
            android:layout_gravity="bottom"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            android:background="?attr/colorOutlineVariant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="8dp"
            android:textAppearance="@style/TextAppearance.FinMon.Kicker"
            android:textColor="?attr/colorPrimary"
            android:text="@string/app_name" />
    </LinearLayout>

    <!-- Strong under-rule (2 dp ink) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/fm_rule_strong"
        android:layout_marginTop="8dp"
        android:background="?attr/colorOutline" />
</LinearLayout>
