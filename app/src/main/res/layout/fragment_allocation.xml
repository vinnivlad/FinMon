<?xml version="1.0" encoding="utf-8"?>
<!--
    Allocation page (Charts → Allocation tab). Pie views over the user's holdings
    at the active window's end-date, switchable via the chip group: by type, by
    currency, or by individual asset.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/allocationFilterChips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:chipSpacingHorizontal="8dp"
        app:singleLine="true"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.chip.Chip
            android:id="@+id/allocationByType"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/analytics_filter_by_type" />

        <com.google.android.material.chip.Chip
            android:id="@+id/allocationByCurrency"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/analytics_filter_by_currency" />

        <com.google.android.material.chip.Chip
            android:id="@+id/allocationByAsset"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/analytics_filter_by_asset" />
    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:id="@+id/allocationSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:alpha="0.7"
        android:paddingHorizontal="16dp"
        android:paddingTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/allocationFilterChips"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Composition in USD" />

    <com.github.mikephil.charting.charts.PieChart
        android:id="@+id/allocationPie"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/allocationSubtitle"
        app:layout_constraintBottom_toTopOf="@id/allocationFxGapHint"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/allocationFxGapHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/analytics_fx_gap_hint"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:alpha="0.7"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/allocationEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/analytics_empty"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:alpha="0.7"
        android:textAlignment="center"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/allocationPie"
        app:layout_constraintBottom_toBottomOf="@id/allocationPie"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
