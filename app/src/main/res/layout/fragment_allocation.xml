<?xml version="1.0" encoding="utf-8"?>
<!--
    Charts → Allocation page (editorial).
    Top: section-without-card kicker ("ALLOCATION · BY TYPE") + filter chip
    group, framed by hairlines.
    Middle: donut/pie centered.
    Bottom: legend list — color swatch · label · pct · value.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/allocationScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- ===== Kicker + filter section ===== -->
            <LinearLayout
                android:id="@+id/allocationHeader"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/fm_page_padding_h"
                android:layout_marginTop="12dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/fm_rule_strong"
                    android:background="?attr/colorOutline" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <View
                        android:layout_width="28dp"
                        android:layout_height="4dp"
                        android:layout_gravity="top|start"
                        android:background="?attr/colorPrimary" />

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="4dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:id="@+id/allocationLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.FinMon.Kicker"
                            tools:text="ALLOCATION · BY TYPE" />

                        <TextView
                            android:id="@+id/allocationSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.FinMon.Body.Small"
                            android:layout_marginTop="2dp"
                            tools:text="Composition in USD" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/allocationFilterChips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            app:chipSpacingHorizontal="8dp"
                            app:singleLine="true"
                            app:singleSelection="true"
                            app:selectionRequired="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/allocationByType"
                                style="@style/Widget.FinMon.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="@string/analytics_filter_by_type" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/allocationByCurrency"
                                style="@style/Widget.FinMon.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/analytics_filter_by_currency" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/allocationByAsset"
                                style="@style/Widget.FinMon.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/analytics_filter_by_asset" />
                        </com.google.android.material.chip.ChipGroup>
                    </LinearLayout>
                </FrameLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/fm_rule_hairline"
                    android:background="?attr/colorOutlineVariant" />
            </LinearLayout>

            <!-- ===== Pie ===== -->
            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/allocationPie"
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:layout_marginTop="8dp" />

            <!-- ===== Legend list ===== -->
            <LinearLayout
                android:id="@+id/allocationLegend"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/fm_page_padding_h"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/allocationFxGapHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/analytics_fx_gap_hint"
                android:textAppearance="@style/TextAppearance.FinMon.Body.Italic"
                android:layout_marginHorizontal="@dimen/fm_page_padding_h"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/allocationEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/analytics_empty"
                android:textAppearance="@style/TextAppearance.FinMon.Body.Italic"
                android:textAlignment="center"
                android:padding="32dp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
