<?xml version="1.0" encoding="utf-8"?>
<!--
    Charts → Growth page (editorial).
    Top: section-without-card totals — kicker, colored split headline (% sign-
    colored per design).
    Middle: zero-anchored % growth line (recolors at zero crossings).
    Bottom: scrollable "best & worst months" list (top 2 + bottom 2).
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/growthScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- ===== Totals section ===== -->
            <LinearLayout
                android:id="@+id/growthTotalsCard"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/fm_page_padding_h"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/fm_rule_strong"
                    android:background="?attr/colorOutline" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <View
                        android:layout_width="28dp"
                        android:layout_height="4dp"
                        android:layout_gravity="top|start"
                        android:background="?attr/colorPrimary" />

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="4dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:id="@+id/growthLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.FinMon.Kicker"
                            tools:text="PERIOD P&amp;L · 1y" />

                        <!-- Headline: signed percentage + absolute growth beside it.
                             Both colors flip with sign per design. -->
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:baselineAligned="true"
                            android:layout_marginTop="2dp">

                            <TextView
                                android:id="@+id/growthHeadline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.FinMon.Display.Headline"
                                android:textFontWeight="500"
                                android:letterSpacing="-0.025"
                                tools:text="+12.4%"
                                tools:textColor="@color/pnl_positive" />

                            <TextView
                                android:id="@+id/growthHeadlineAbsolute"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.FinMon.Mono.Medium"
                                android:layout_marginStart="10dp"
                                android:layout_gravity="bottom"
                                android:layout_marginBottom="6dp"
                                tools:text="+5,066 USD"
                                tools:textColor="@color/pnl_positive" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/fm_rule_hairline"
                    android:background="?attr/colorOutlineVariant" />
            </LinearLayout>

            <!-- ===== Chart ===== -->
            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/growthChart"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="8dp" />

            <!-- ===== Best & worst months ===== -->
            <LinearLayout
                android:id="@+id/bestWorstSection"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/fm_page_padding_h"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/charts_growth_best_worst_label"
                    android:textAppearance="@style/TextAppearance.FinMon.Kicker"
                    android:paddingBottom="4dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/fm_rule_hairline"
                    android:background="?attr/colorOutlineVariant" />

                <!-- Up to 4 rows inflated by the page (2 best + 2 worst). -->
                <LinearLayout
                    android:id="@+id/bestWorstList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <TextView
                android:id="@+id/growthFxGapHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/totals_fx_gap_hint"
                android:textAppearance="@style/TextAppearance.FinMon.Body.Italic"
                android:layout_marginHorizontal="@dimen/fm_page_padding_h"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/growthEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/charts_growth_empty"
                android:textAppearance="@style/TextAppearance.FinMon.Body.Italic"
                android:textAlignment="center"
                android:padding="32dp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
