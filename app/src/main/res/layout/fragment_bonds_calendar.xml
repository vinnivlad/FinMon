<?xml version="1.0" encoding="utf-8"?>
<!--
    Bonds → Calendar tab. Weekday legend (S M T W T F S) at the top, then an
    infinite-scrolling vertical CalendarView below. Day cells are bound by
    BondsCalendarPageFragment with payment-date markers.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/weekdayLegend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="2dp"
        android:paddingVertical="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.kizitonwose.calendar.view.CalendarView
        android:id="@+id/calendarView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:cv_dayViewResource="@layout/view_calendar_day"
        app:cv_monthHeaderResource="@layout/view_calendar_month_header"
        app:cv_orientation="vertical"
        app:cv_scrollPaged="false"
        app:layout_constraintTop_toBottomOf="@id/weekdayLegend"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
