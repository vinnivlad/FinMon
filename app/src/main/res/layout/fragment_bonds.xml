<?xml version="1.0" encoding="utf-8"?>
<!--
  Bonds screen body. Top: Expected Payments card (per-currency totals + base).
  Below: TabLayout with Holdings + Calendar pages in a ViewPager2.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/expectedPaymentsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/expectedPaymentsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bonds_expected_payments_label"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:alpha="0.7"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/expectedPaymentsHeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:layout_marginTop="4dp"
                tools:text="2,000.00 USD" />

            <TextView
                android:id="@+id/expectedPaymentsEquivalents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:alpha="0.7"
                android:layout_marginTop="2dp"
                tools:text="≈ 1,840.00 EUR · 75,000 UAH" />

            <TextView
                android:id="@+id/expectedPaymentsCoupons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:layout_marginTop="8dp"
                tools:text="Coupons: 1,200.00 USD, 50,000.00 UAH" />

            <TextView
                android:id="@+id/expectedPaymentsMaturity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:layout_marginTop="2dp"
                tools:text="Maturity: 25,000.00 UAH" />

            <TextView
                android:id="@+id/expectedPaymentsEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:alpha="0.7"
                android:visibility="gone"
                android:text="@string/bonds_expected_payments_none" />

            <TextView
                android:id="@+id/expectedPaymentsFxGap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:alpha="0.6"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                android:text="@string/bonds_expected_payments_fx_gap" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/bondsTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/expectedPaymentsCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tabMode="fixed" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/bondsPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/bondsTabs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
