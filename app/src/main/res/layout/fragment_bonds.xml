<?xml version="1.0" encoding="utf-8"?>
<!--
    Bonds screen body.
    ▸ Top: editorial summary section (no card) — 2 dp ink top rule, 28×4 accent
      stripe, kicker label, split-headline number, FX-equivalents ribbon, 1 dp
      internal rule, then Coupons / Maturity rows. Mirrors Portfolio's totals
      section so the screens read as one family.
    ▸ Below: TabLayout with Holdings + Calendar pages in a ViewPager2.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ===== Bonds summary section ===== -->
    <LinearLayout
        android:id="@+id/expectedPaymentsCard"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/fm_page_padding_h"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/fm_rule_strong"
            android:background="?attr/colorOutline" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Accent stripe: 28×4, top-start, kisses the top rule -->
            <View
                android:layout_width="28dp"
                android:layout_height="4dp"
                android:layout_gravity="top|start"
                android:background="?attr/colorPrimary" />

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="4dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/expectedPaymentsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bonds_expected_payments_label"
                    android:textAppearance="@style/TextAppearance.FinMon.Kicker" />

                <!-- Headline number: integer + fraction + currency code -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/expectedPaymentsHeadlineInteger"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.FinMon.Display.Headline"
                        android:textFontWeight="500"
                        android:letterSpacing="-0.025"
                        tools:text="2,000" />

                    <TextView
                        android:id="@+id/expectedPaymentsHeadlineFraction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.FinMon.Display.Small"
                        android:textColor="@color/fm_ink_soft"
                        android:layout_marginStart="2dp"
                        tools:text=".00" />

                    <TextView
                        android:id="@+id/expectedPaymentsHeadlineCurrency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.FinMon.Kicker"
                        android:layout_marginStart="8dp"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="6dp"
                        tools:text="USD" />
                </LinearLayout>

                <TextView
                    android:id="@+id/expectedPaymentsEquivalents"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.FinMon.Mono.Small"
                    android:layout_marginTop="6dp"
                    tools:text="≈ 1,840.00 EUR · 75,000 UAH" />

                <!-- Empty-state line replaces the headline + breakdown when no payments. -->
                <TextView
                    android:id="@+id/expectedPaymentsEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bonds_expected_payments_none"
                    android:textAppearance="@style/TextAppearance.FinMon.Body.Italic"
                    android:layout_marginTop="6dp"
                    android:visibility="gone" />

                <!-- Internal hairline rule -->
                <View
                    android:id="@+id/expectedPaymentsInnerRule"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/fm_rule_hairline"
                    android:layout_marginTop="10dp"
                    android:background="?attr/colorOutlineVariant" />

                <!-- Coupons row: kicker label (left) + mono multi-currency amounts (right) -->
                <LinearLayout
                    android:id="@+id/expectedPaymentsCouponsRow"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/bonds_summary_label_coupons"
                        android:textAppearance="@style/TextAppearance.FinMon.Kicker" />

                    <TextView
                        android:id="@+id/expectedPaymentsCoupons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.FinMon.Mono.Small"
                        android:textColor="@color/fm_ink"
                        tools:text="50,000.00 UAH · 1,200.00 USD" />
                </LinearLayout>

                <!-- Maturity row -->
                <LinearLayout
                    android:id="@+id/expectedPaymentsMaturityRow"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:baselineAligned="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/bonds_summary_label_maturity"
                        android:textAppearance="@style/TextAppearance.FinMon.Kicker" />

                    <TextView
                        android:id="@+id/expectedPaymentsMaturity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.FinMon.Mono.Small"
                        android:textColor="@color/fm_ink"
                        tools:text="25,000.00 UAH" />
                </LinearLayout>

                <TextView
                    android:id="@+id/expectedPaymentsFxGap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bonds_expected_payments_fx_gap"
                    android:textAppearance="@style/TextAppearance.FinMon.Body.Italic"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/fm_rule_hairline"
            android:background="?attr/colorOutlineVariant" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/bondsTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/expectedPaymentsCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tabMode="fixed" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/bondsPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/bondsTabs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
