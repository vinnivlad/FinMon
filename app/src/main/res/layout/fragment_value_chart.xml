<?xml version="1.0" encoding="utf-8"?>
<!--
    Value chart page (Charts → Value tab). Renders the user's portfolio value and
    invested-capital lines over the global filter's window. Identical to the old
    standalone Chart screen body.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/totalsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/totalsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/totals_card_label"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:alpha="0.7"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/totalAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:layout_marginTop="4dp"
                tools:text="12,345.67 USD" />

            <TextView
                android:id="@+id/totalInvested"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:alpha="0.8"
                android:layout_marginTop="6dp"
                tools:text="Invested: 10,000.00 USD" />

            <TextView
                android:id="@+id/totalPnl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                tools:text="Period P&amp;L: +123.45 USD (+1.2%)"
                tools:textColor="@color/pnl_positive" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/totalsCard"
        app:layout_constraintBottom_toTopOf="@id/fxGapHint"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/fxGapHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/totals_fx_gap_hint"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:alpha="0.7"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/emptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/chart_empty"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:alpha="0.7"
        android:textAlignment="center"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/chart"
        app:layout_constraintBottom_toBottomOf="@id/chart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
