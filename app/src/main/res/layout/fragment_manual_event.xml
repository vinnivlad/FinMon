<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/manual_event_help"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:alpha="0.7"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/kindChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/kindChipIncome"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/manual_event_kind_income" />

            <com.google.android.material.chip.Chip
                android:id="@+id/kindChipMaturity"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manual_event_kind_maturity" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/assetLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/manual_event_field_asset">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/asset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                tools:text="VOO · STOCK · USD" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/emptyAssetsHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/manual_event_no_assets"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:alpha="0.7"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/amountLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/manual_event_field_amount">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/amountHelp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/manual_event_amount_help"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:alpha="0.7"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/redemptionPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            tools:text="Cash returned: 10,000.00 UAH (face 1,000.00 × 10)"
            tools:visibility="visible" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/payDateLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/manual_event_field_date">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/payDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:focusable="false"
                android:clickable="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/action_save" />
    </LinearLayout>
</ScrollView>
