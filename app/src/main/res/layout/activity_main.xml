<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
        Activity-scoped editorial masthead. Always visible across all destinations;
        the title is set per-destination from MainActivity. The gear icon is the
        single entry point to Settings.
    -->
    <include
        android:id="@+id/masthead"
        layout="@layout/view_masthead"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        Activity-scoped global filter. Visibility is driven by MainActivity from a
        NavController.OnDestinationChangedListener — visible on Portfolio, Breakdown,
        Chart (and later Bonds), hidden on Market, Settings, and modal sub-screens.
    -->
    <include
        android:id="@+id/globalFilter"
        layout="@layout/view_global_filter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/masthead"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintTop_toBottomOf="@id/globalFilter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:navGraph="@navigation/nav_graph" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:menu="@menu/bottom_nav_menu" />

    <!--
        Startup sync overlay. Covers the whole activity (including bottom nav) while the
        startup sync runs, so the user can't interact with stale or partial data. Hidden
        once the orchestrator emits Stage.DONE.

        clickable=true is what blocks touches from leaking through to the views beneath.
    -->
    <FrameLayout
        android:id="@+id/startupOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?android:attr/colorBackground"
        android:clickable="true"
        android:focusable="true"
        android:elevation="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="32dp">

            <ProgressBar
                android:id="@+id/startupProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/startupStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textAlignment="center"
                tools:text="Fetching prices: VOO (1/3)" />

            <TextView
                android:id="@+id/startupErrorTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:text="@string/startup_failed_title"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/startupErrorMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textAlignment="center"
                android:alpha="0.8"
                android:visibility="gone"
                tools:text="Network error: timeout"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startupRetry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/startup_action_retry"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startupContinue"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/startup_action_continue"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </FrameLayout>

    <!--
        App-lock overlay. Sits on top of everything (including the startup overlay)
        until biometric / device-credential auth succeeds. Covers all data so the
        screen is unreadable when the device is unlocked but FinMon is locked.

        clickable=true blocks touches from leaking through. Visible by default —
        MainActivity hides it after the first successful unlock and re-shows it on
        every onStart while the activity is locked.
    -->
    <FrameLayout
        android:id="@+id/lockOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?android:attr/colorBackground"
        android:clickable="true"
        android:focusable="true"
        android:elevation="16dp"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="32dp">

            <TextView
                android:id="@+id/lockTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:text="@string/app_lock_title" />

            <TextView
                android:id="@+id/lockSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textAlignment="center"
                android:alpha="0.8"
                android:text="@string/app_lock_subtitle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/lockUnlockButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/app_lock_action_unlock" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
