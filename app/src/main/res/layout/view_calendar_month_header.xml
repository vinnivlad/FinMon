<?xml version="1.0" encoding="utf-8"?>
<!--
    Month header rendered above each month's grid in the infinite scroll.
    Editorial split: italic serif month name (left) and Inter-kicker payment
    count (right), framed by a 1 dp top hairline so each month reads as its
    own banded section.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/fm_rule_hairline"
        android:background="?attr/colorOutlineVariant" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="true"
        android:paddingHorizontal="@dimen/fm_page_padding_h"
        android:paddingTop="4dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/monthHeaderText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.FinMon.Title.Small"
            android:textStyle="italic"
            tools:text="January 2026" />

        <TextView
            android:id="@+id/monthHeaderEvents"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.FinMon.Kicker"
            tools:text="3 events" />
    </LinearLayout>
</LinearLayout>
