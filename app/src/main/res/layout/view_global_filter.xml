<?xml version="1.0" encoding="utf-8"?>
<!--
    Global filter bar — shared by Portfolio, Bonds, Breakdown, Chart. The action row
    (gear icon → Settings) is always visible since Settings was demoted out of the
    5-item bottom nav. The chip rows below the action row hide on screens that
    don't react to the global filter (Market, Settings, modal sub-screens).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:background="?android:attr/colorBackground">

    <!-- Action row — always visible. Gear icon for Settings (and anything else we
         add later: e.g. Market launch). -->
    <LinearLayout
        android:id="@+id/globalFilterActionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/globalSettingsButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_title" />
    </LinearLayout>

    <!-- Chip rows — hidden on Market / Settings / modal sub-screens. -->
    <LinearLayout
        android:id="@+id/globalFilterChipsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <HorizontalScrollView
            android:id="@+id/globalCurrencyChipsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/globalCurrencyChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:singleLine="true"
                app:singleSelection="true"
                app:selectionRequired="true" />
        </HorizontalScrollView>

        <HorizontalScrollView
            android:id="@+id/globalPeriodChipsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/globalPeriodChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:singleLine="true"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/globalPeriodChip5d"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chart_period_5d" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/globalPeriodChip1m"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chart_period_1m" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/globalPeriodChip6m"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chart_period_6m" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/globalPeriodChipYtd"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chart_period_ytd" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/globalPeriodChip1y"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chart_period_1y" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/globalPeriodChip5y"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chart_period_5y" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/globalPeriodChipAll"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/chart_period_all" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/globalPeriodChipCustom"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chart_period_custom" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
    </LinearLayout>

</LinearLayout>
