<?xml version="1.0" encoding="utf-8"?>
<!--
    Cash deposit / withdrawal (editorial). Top: italic body explaining the screen.
    "Direction" accent kicker over a Deposit / Withdrawal chip group, then currency
    and amount. No date field — the event is stamped at the current wall-clock time
    (see CashFragment), which keeps it clear of the noon trade-leg detection.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/fm_page_padding_h"
        android:paddingTop="12dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cash_help"
            android:textAppearance="@style/TextAppearance.FinMon.Body.Italic"
            android:textSize="13sp"
            android:layout_marginBottom="14dp" />

        <!-- DIRECTION accent kicker. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cash_section_direction"
                android:textAppearance="@style/TextAppearance.FinMon.Kicker"
                android:textColor="@color/fm_accent"
                android:textFontWeight="700" />

            <View
                android:layout_width="0dp"
                android:layout_height="@dimen/fm_rule_hairline"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="?attr/colorOutlineVariant" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/directionChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:chipSpacingHorizontal="6dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/directionChipDeposit"
                style="@style/Widget.FinMon.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/cash_direction_deposit" />

            <com.google.android.material.chip.Chip
                android:id="@+id/directionChipWithdrawal"
                style="@style/Widget.FinMon.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cash_direction_withdrawal" />
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/currencyLayout"
            style="@style/Widget.FinMon.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/cash_field_currency">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/currency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                tools:text="USD" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/amountLayout"
            style="@style/Widget.FinMon.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/cash_field_amount">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cash_amount_help"
            android:textAppearance="@style/TextAppearance.FinMon.Body.Italic"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            style="@style/Widget.FinMon.Button.Save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/action_save" />
    </LinearLayout>
</ScrollView>
