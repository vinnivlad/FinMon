<?xml version="1.0" encoding="utf-8"?>
<!--
  Landscape variant for the Value chart page. 30/70 split: totals card on the left,
  chart on the right. Same view IDs as portrait so FragmentValueChartBinding stays
  single. The filter bar lives in activity_main.xml above this fragment.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/columnSplit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.30" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/columnSplit">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/totalsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/totalsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/totals_card_label"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:alpha="0.7"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/totalAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:layout_marginTop="4dp"
                    tools:text="12,345.67 USD" />

                <TextView
                    android:id="@+id/totalInvested"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:alpha="0.8"
                    android:layout_marginTop="6dp"
                    tools:text="Invested: 10,000.00 USD" />

                <TextView
                    android:id="@+id/totalPnl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    tools:text="Period P&amp;L: +123.45 USD (+1.2%)"
                    tools:textColor="@color/pnl_positive" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>

    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/chart"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/fxGapHint"
        app:layout_constraintStart_toEndOf="@id/columnSplit"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/fxGapHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/totals_fx_gap_hint"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:alpha="0.7"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/columnSplit"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/emptyState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/chart_empty"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:alpha="0.7"
        android:textAlignment="center"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/chart"
        app:layout_constraintBottom_toBottomOf="@id/chart"
        app:layout_constraintStart_toEndOf="@id/columnSplit"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
