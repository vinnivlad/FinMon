<?xml version="1.0" encoding="utf-8"?>
<!--
    Landscape variant for the Value chart page (editorial). 30/70 split:
    totals + readout on the left (scrollable), chart on the right. Same view IDs
    as portrait so FragmentValueChartBinding stays single.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/columnSplit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.30" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/columnSplit">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== Totals section ===== -->
            <LinearLayout
                android:id="@+id/totalsCard"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/fm_page_padding_h"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/fm_rule_strong"
                    android:background="?attr/colorOutline" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <View
                        android:layout_width="28dp"
                        android:layout_height="4dp"
                        android:layout_gravity="top|start"
                        android:background="?attr/colorPrimary" />

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="4dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:id="@+id/totalsLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.FinMon.Kicker"
                            tools:text="PORTFOLIO VALUE · 6m" />

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:baselineAligned="true"
                            android:layout_marginTop="4dp">

                            <TextView
                                android:id="@+id/totalAmountInteger"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.FinMon.Display.Large"
                                android:textFontWeight="500"
                                android:letterSpacing="-0.025"
                                tools:text="136,414" />

                            <TextView
                                android:id="@+id/totalAmountFraction"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.FinMon.Display.Small"
                                android:textColor="@color/fm_ink_soft"
                                android:layout_marginStart="2dp"
                                tools:text=".93" />

                            <TextView
                                android:id="@+id/totalAmountCurrency"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.FinMon.Kicker"
                                android:layout_marginStart="6dp"
                                android:layout_gravity="bottom"
                                android:layout_marginBottom="4dp"
                                tools:text="USD" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/fm_rule_hairline"
                            android:layout_marginTop="10dp"
                            android:background="?attr/colorOutlineVariant" />

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp">

                            <TextView
                                android:id="@+id/totalInvested"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.FinMon.Body.Small"
                                tools:text="Invested 114,085.56" />

                            <TextView
                                android:id="@+id/totalPnl"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.FinMon.Mono.Medium"
                                android:layout_marginTop="4dp"
                                tools:text="▲ +5,065.86 (+4.5%)"
                                tools:textColor="@color/pnl_positive" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/fm_rule_hairline"
                    android:background="?attr/colorOutlineVariant" />
            </LinearLayout>

            <!-- ===== Readout strip ===== -->
            <LinearLayout
                android:id="@+id/readoutStrip"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/fm_page_padding_h"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                tools:visibility="visible">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/fm_rule_hairline"
                    android:background="?attr/colorOutlineVariant" />

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="10dp"
                    android:weightSum="3">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/charts_readout_high"
                            android:textAppearance="@style/TextAppearance.FinMon.Kicker" />
                        <TextView
                            android:id="@+id/readoutHighValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.FinMon.Mono.Medium"
                            android:textSize="13sp"
                            android:layout_marginTop="2dp"
                            tools:text="141,201" />
                        <TextView
                            android:id="@+id/readoutHighSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.FinMon.Body.Small"
                            android:layout_marginTop="1dp"
                            tools:text="Apr 2026" />
                    </LinearLayout>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/charts_readout_low"
                            android:textAppearance="@style/TextAppearance.FinMon.Kicker" />
                        <TextView
                            android:id="@+id/readoutLowValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.FinMon.Mono.Medium"
                            android:textSize="13sp"
                            android:layout_marginTop="2dp"
                            tools:text="94,820" />
                        <TextView
                            android:id="@+id/readoutLowSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.FinMon.Body.Small"
                            android:layout_marginTop="1dp"
                            tools:text="Jun 2024" />
                    </LinearLayout>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/charts_readout_delta"
                            android:textAppearance="@style/TextAppearance.FinMon.Kicker" />
                        <TextView
                            android:id="@+id/readoutDeltaValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.FinMon.Mono.Medium"
                            android:textSize="13sp"
                            android:layout_marginTop="2dp"
                            tools:text="+5,066" />
                        <TextView
                            android:id="@+id/readoutDeltaSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.FinMon.Body.Small"
                            android:layout_marginTop="1dp"
                            tools:text="Nov → May" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/fm_rule_hairline"
                    android:background="?attr/colorOutlineVariant" />
            </LinearLayout>

            <TextView
                android:id="@+id/fxGapHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/totals_fx_gap_hint"
                android:textAppearance="@style/TextAppearance.FinMon.Body.Italic"
                android:layout_marginHorizontal="@dimen/fm_page_padding_h"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/chart"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/columnSplit"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/emptyState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/chart_empty"
        android:textAppearance="@style/TextAppearance.FinMon.Body.Italic"
        android:textAlignment="center"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/chart"
        app:layout_constraintBottom_toBottomOf="@id/chart"
        app:layout_constraintStart_toEndOf="@id/columnSplit"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
