<?xml version="1.0" encoding="utf-8"?>
<!--
  Landscape variant for the global Chart screen. 30/70 split via vertical guideline:
    Left column (30%)  — currency chips, period chips, totals card
    Right column (70%) — chart + fx-gap hint
  Same view IDs as portrait so FragmentChartBinding stays identical.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/columnSplit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.30" />

    <!-- ─── Left column: filters + totals ─────────────────────────────── -->

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/columnSplit">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <HorizontalScrollView
                android:id="@+id/currencyChipsScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/currencyChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:singleLine="true"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/currencyChipAll"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/chart_currency_all" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/currencyChipUsd"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="USD" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/currencyChipEur"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EUR" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/currencyChipUah"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UAH" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <HorizontalScrollView
                android:id="@+id/periodChipsScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/periodChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:singleLine="true"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/periodChip5d"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chart_period_5d" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/periodChip1m"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chart_period_1m" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/periodChip6m"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chart_period_6m" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/periodChipYtd"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chart_period_ytd" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/periodChip1y"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chart_period_1y" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/periodChip5y"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chart_period_5y" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/periodChipAll"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/chart_period_all" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/periodChipCustom"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chart_period_custom" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/totalsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/totalsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/totals_card_label"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:alpha="0.7"
                        android:textAllCaps="true" />

                    <TextView
                        android:id="@+id/totalAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:layout_marginTop="4dp"
                        tools:text="12,345.67 USD" />

                    <TextView
                        android:id="@+id/totalInvested"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:alpha="0.8"
                        android:layout_marginTop="6dp"
                        tools:text="Invested: 10,000.00 USD" />

                    <TextView
                        android:id="@+id/totalPnl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"
                        tools:text="Period P&amp;L: +123.45 USD (+1.2%)"
                        tools:textColor="@color/pnl_positive" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- ─── Right column: chart + fx hint + empty state ──────────────── -->

    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/chart"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/fxGapHint"
        app:layout_constraintStart_toEndOf="@id/columnSplit"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/fxGapHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/totals_fx_gap_hint"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:alpha="0.7"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/columnSplit"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/emptyState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/chart_empty"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:alpha="0.7"
        android:textAlignment="center"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/chart"
        app:layout_constraintBottom_toBottomOf="@id/chart"
        app:layout_constraintStart_toEndOf="@id/columnSplit"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
