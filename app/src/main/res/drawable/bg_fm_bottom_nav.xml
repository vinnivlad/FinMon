<?xml version="1.0" encoding="utf-8"?>
<!--
    Bottom-nav background with a 2 dp ink (ruleStrong) top border per editorial spec.
    The bottom nav itself supplies the cream/charcoal fill via colorBackground; the
    layered top item paints the ink stripe on top of that.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?android:attr/colorBackground" />
        </shape>
    </item>
    <item android:height="2dp" android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorOnBackground" />
        </shape>
    </item>
</layer-list>
